# ===========================================
# Environment Variables for Chapter 5
# ===========================================
# This is a demo file to show how .env works
#
# HOW TO USE:
# 1. Copy this file and rename it to .env
# 2. Replace the placeholder values with your actual keys
# 3. Never push your .env file to GitHub
# ===========================================

# Your Gemini API key (get it free from https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-will-go-here

# Your OpenAI API key (get it from https://platform.openai.com)
OPENAI_API_KEY=your-openai-api-key-will-go-here

# Your Anthropic Claude API key (get it from https://console.anthropic.com)
ANTHROPIC_API_KEY=your-anthropic-api-key-will-go-here

# Your HuggingFace access token (get it from https://huggingface.co/settings/tokens)
HF_TOKEN=your-huggingface-token-will-go-here
